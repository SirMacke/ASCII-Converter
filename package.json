{
  "name": "@sirmacke/ascii-converter",
  "version": "2.0.0",
  "description": "Convert images to ASCII art in the terminal, with colour, custom character ramps and a small library API.",
  "keywords": [
    "ascii",
    "ascii-art",
    "image",
    "terminal",
    "cli",
    "ansi",
    "converter",
    "gif"
  ],
  "license": "MIT",
  "author": "Maxmilian Helmersson (https://github.com/SirMacke)",
  "homepage": "https://github.com/SirMacke/ASCII-Converter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirMacke/ASCII-Converter.git"
  },
  "bugs": {
    "url": "https://github.com/SirMacke/ASCII-Converter/issues"
  },
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "ascii-converter": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "npm run build && vitest run",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "examples": "node scripts/make-examples.mjs",
    "check:web": "vite build && node scripts/check-web.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.4",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
